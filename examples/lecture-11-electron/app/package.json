{
  "name": "@course/lecture-11-electron",
  "private": true,
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "screenshot": "npm run build && electron . --screenshot",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run build && electron-packager . TaskDesk --out=release --overwrite --ignore=^/src/ --ignore=^/tests/ --ignore=^/renderer/ --ignore=^/vite.config.mjs",
    "test:desktop": "npm run build && electron . --self-test",
    "test:ui": "npm run build && node tests/ui.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.7.0",
    "playwright": "1.64.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.7"
  }
}
