{
  "name": "ui-programming-course",
  "version": "0.2.2",
  "private": true,
  "description": "Runnable examples and local testbed for the User Interface Programming course",
  "workspaces": [
    "examples/*",
    "services/*"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "lecture:03": "npm run dev --workspace=@course/lecture-03-react-basics",
    "lecture:04": "npm run dev --workspace=@course/lecture-04-state-events-forms",
    "lecture:05": "concurrently -k -n api,web \"npm run start --workspace=@course/task-api\" \"npm run dev --workspace=@course/lecture-05-routing-api\"",
    "lecture:06": "npm run dev --workspace=@course/lecture-06-state-management",
    "lecture:07": "npm run web --workspace=@course/lecture-07-react-native-basics",
    "lecture:08": "concurrently -k -n api,mobile \"npm run start --workspace=@course/task-api\" \"npm run web --workspace=@course/lecture-08-navigation-state-data\"",
    "lecture:09": "npm run web --workspace=@course/lecture-09-platform-features",
    "screenshots:03": "npm run screenshots --workspace=@course/lecture-03-react-basics",
    "screenshots:04": "npm run screenshots --workspace=@course/lecture-04-state-events-forms",
    "screenshots:05": "npm run screenshots --workspace=@course/lecture-05-routing-api",
    "screenshots:06": "npm run screenshots --workspace=@course/lecture-06-state-management",
    "screenshots:07": "npm run screenshots --workspace=@course/lecture-07-react-native-basics",
    "screenshots:08": "npm run screenshots --workspace=@course/lecture-08-navigation-state-data",
    "screenshots:09": "npm run screenshots --workspace=@course/lecture-09-platform-features"
  },
  "devDependencies": {
    "concurrently": "latest"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  }
}
